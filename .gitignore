node_modules/
dist/
dist-ssr/
dev-dist/
.DS_Store
*.local

# Real art assets are dropped in locally / fetched separately; keep the
# repo small and let AssetLoader's placeholder fallback cover their absence,
# except for specific verified-CC0 assets explicitly allow-listed below.
# Lives under public/ (not a bare top-level /assets) so Vite's production
# build actually copies it into dist/ - see vite.config.ts's build.assetsDir
# comment for why that doesn't collide with Vite's own bundle output.
public/assets/models/*
!public/assets/models/.gitkeep
!public/assets/models/knight.glb
!public/assets/models/dragon.glb
!public/assets/models/dragon-quaternius.glb
public/assets/animations/*
!public/assets/animations/.gitkeep
public/assets/textures/*
!public/assets/textures/.gitkeep
public/assets/audio/music/*
!public/assets/audio/music/.gitkeep
!public/assets/audio/music/theme-1.ogg
!public/assets/audio/music/theme-2.ogg
!public/assets/audio/music/theme-6.ogg
public/assets/audio/sfx/*
!public/assets/audio/sfx/.gitkeep
!public/assets/audio/sfx/attack-swing-1.ogg
!public/assets/audio/sfx/attack-swing-2.ogg
!public/assets/audio/sfx/hit-dragon.ogg
!public/assets/audio/sfx/hit-player.ogg
!public/assets/audio/sfx/dodge.ogg
!public/assets/audio/sfx/dragon-windup.ogg
!public/assets/audio/sfx/success.ogg
!public/assets/audio/sfx/ui-tap.wav

*.log
.vscode/*
!.vscode/extensions.json
